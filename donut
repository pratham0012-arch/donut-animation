#include <stdio.h>
#include <string.h>
#include <math.h>

// Cross-platform sleep macro
#ifdef _WIN32
    #include <windows.h>
    #define sleep_ms(ms) Sleep(ms)
#else
    #include <unistd.h>
    #define sleep_ms(ms) usleep((ms) * 1000)
#endif

int main() {
    float A = 0, B = 0;
    float i, j;
    int k;
    float z[1760];
    char b[1760];

    // Clear screen (ANSI escape code)
    printf("\x1b[2J");

    for (;;) {
        memset(b, 32, 1760); // Fill screen buffer with spaces
        memset(z, 0, 7040);  // Clear depth (Z) buffer

        // Sample points across the torus surface
        for (j = 0; j < 6.28; j += 0.07) {
            for (i = 0; i < 6.28; i += 0.02) {
                float c = sin(i);
                float d = cos(j);
                float e = sin(A);
                float f = sin(j);
                float g = cos(A);
                float h = d + 2; // Distance from center to torus cross-section
                float D = 1 / (c * h * e + f * g + 5); // 1/z depth projection
                float l = cos(i);
                float m = cos(B);
                float n = sin(B);
                float t = c * h * g - f * e;

                // 3D to 2D screen coordinate projection
                int x = 40 + 30 * D * (l * h * m - t * n);
                int y = 12 + 15 * D * (l * h * n + t * m);
                int o = x + 80 * y;

                // Luminance / lighting surface normal vector calculation
                int N = 8 * ((f * e - c * d * g) * m - c * d * e - f * g - l * d * n);

                // Render point if within screen bounds and closer than existing pixel
                if (22 > y && y > 0 && x > 0 && 80 > x && D > z[o]) {
                    z[o] = D;
                    // Map luminance N to punctuation mark characters
                    b[o] = ".,-~:;=!*#$@"[N > 0 ? N : 0];
                }
            }
        }

        // Reset cursor position to top-left corner
        printf("\x1b[H");

        // Print character buffer to terminal
        for (k = 0; k < 1761; k++) {
            putchar(k % 80 ? b[k] : 10);
        }

        // Increment rotation angles
        A += 0.04;
        B += 0.02;

        // Delay ~30 milliseconds (~30 FPS)
        sleep_ms(30);
    }

    return 0;
}
